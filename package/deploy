#/usr/bin/sh

if [ $# -gt 2 ]
then
	echo "Usage: deploy <local/system>"
	exit 1
fi

option="system"
if [ $# -eq 1 ]
then
	option=$1
fi
#option=$1

if [ $option = "local" ]
then
	cd build 
	luarocks --local make
else
	cd build
	luarocks make
fi

RET=$?
if [ "$RET" -ne 0 ]; then exit "$RET"; fi
if [ -f ../api-clients.lua ]; then
    (cd .. && biop-clients publish)
fi
