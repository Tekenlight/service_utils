#/usr/bin/sh

LUA_CPATH="./?.so;$HOME/.luarocks/lib/lua/5.3/?.so;$LUA_CPATH"
export LUA_CPATH

LUA_PATH="./?.lua;$HOME/.luarocks/share/lua/5.3/?.lua;$LUA_PATH"
export LUA_PATH

OS=`uname`
if [ $OS = "Darwin" ]
then
	DYLD_FALLBACK_LIBRARY_PATH=$HOME/usr/local/lib:$HOME/usr/lib:$HOME/.luarocks/lib/lua/5.3:$HOME/usr/local/tmp/cling-obj/lib:$HOME/lib:$HOME/bin_poco/lib:/usr/local/lib:/lib:/usr/lib:/opt/local/lib:/opt/local/lib/postgresql13
	export DYLD_FALLBACK_LIBRARY_PATH
	DYLD_LIBRARY_PATH=DYLD_FALLBACK_LIBRARY_PATH
	export DYLD_LIBRARY_PATH
fi

if [ $# -lt 1 ]
then
    echo "Usage: gidl file [-b 0/1] [-d directory] [-j output.js -m runtime-module -r receipt.json]"
    exit 1
fi

file=$1
shift
output_directory=
javascript_output=
javascript_module=
javascript_receipt=
# while getopts b:d: flag
while getopts b:d:j:m:r: opt
do
	case $opt in
		d) output_directory=$OPTARG;;
		b) build_mode=$OPTARG;;
		j) javascript_output=$OPTARG;;
		m) javascript_module=$OPTARG;;
		r) javascript_receipt=$OPTARG;;
		\?) echo >&2 "Usage: gidl file [-b 0/1] [-d directory] [-j output.js -m runtime-module -r receipt.json]"
			exit 1;;
	esac
	#echo $OPTIND
done
shift `expr $OPTIND - 1`

# Optional client outputs are resolved before changing into the Lua build directory.
# Existing calls without -j keep the original server-only generation path.
if [ -n "$javascript_output" ]; then
    if [ -z "$javascript_module" ] || [ -z "$javascript_receipt" ]; then
        echo "JavaScript generation requires -j output.js -m runtime-module -r receipt.json" >&2
        exit 1
    fi
    case "$javascript_output" in /*) ;; *) javascript_output="$PWD/$javascript_output";; esac
    case "$javascript_receipt" in /*) ;; *) javascript_receipt="$PWD/$javascript_receipt";; esac
elif [ -n "$javascript_module$javascript_receipt" ]; then
    echo "-m and -r require -j" >&2
    exit 1
fi

echo "Generating IDL:"$file
echo "--------------"
if [ -f $HOME/.luarocks/share/lua/5.3/idl_gen.lua ]
then
    LUA_FILE="$HOME/.luarocks/share/lua/5.3/idl_gen.lua"
elif [ -f /usr/local/share/lua/5.3/idl_gen.lua ]
then
    LUA_FILE="/usr/local/share/lua/5.3/idl_gen.lua"
elif [ -f /opt/local/share/luarocks/share/lua/5.3/idl_gen.lua ]
then
	LUA_FILE="/opt/local/share/luarocks/share/lua/5.3/idl_gen.lua"
elif [ -f $INSTALL_DIRECTORY/usr/share/lua/5.3/idl_gen.lua ] 
then
	LUA_FILE="$INSTALL_DIRECTORY/usr/share/lua/5.3/idl_gen.lua"
else
    echo "File idl_gen not found"
    exit 1
fi
echo "lua $LUA_FILE $file $output_directory"
if [ "$output_directory" != "" ]
then
    mkdir -p $output_directory
    cd $output_directory
	lua "$LUA_FILE" "../$file" "${build_mode:-0}" "$javascript_output" "$javascript_module" "$javascript_receipt"
else
	lua "$LUA_FILE" "$file" "${build_mode:-0}" "$javascript_output" "$javascript_module" "$javascript_receipt"
fi

if [ $? -ne 0 ]
then
	exit 1;
fi

